{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (fast)",
      "description": "Optimized build in ./build. Use this to run the solver and the web demo.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug symbols, no optimization. Use this with the VS Code debugger.",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "description": "Finds memory errors and undefined behavior while the tests run.",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CUBESOLVER_SANITIZE": "ON" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "description": "Finds data races in the parallel search and the server.",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CUBESOLVER_TSAN": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } }
  ]
}
